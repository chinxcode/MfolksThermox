---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

import globalLogistics from "@/assets/images/services/global-logistics.webp";
import warehouseInventory from "@/assets/images/services/warehouse-inventory.webp";
import manufacturingPlant from "@/assets/images/services/manufacturing-plant.webp";
import globalEquipmentSales from "@/assets/images/services/global-equipment-sales.webp";
import spareParts from "@/assets/images/services/spare-parts.webp";
import technicalConsultation from "@/assets/images/services/technical-consultation.webp";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Global Material Supply",
    subTitle:
      "We ensure timely delivery of high-quality thermal spray wires and powders to your facility, wherever you are. Our robust logistics network handles domestic and international shipments with efficiency, ensuring your production lines never stop.",
    single: false,
    imgOne: globalLogistics,
    imgOneAlt: "Global shipping and logistics container.",
    imgTwo: warehouseInventory,
    imgTwoAlt: "Warehouse stocked with thermal spray materials.",
  },
  {
    isRightSection: false,
    title: "Custom Alloy Manufacturing",
    subTitle:
      "Need a specific chemical composition? As a manufacturer, we can develop and produce custom alloy wires and powders tailored to your specific application requirements and industry standards. We work closely with you to meet precise metallurgical specifications.",
    img: manufacturingPlant,
    imgAlt: "Manufacturing of custom thermal spray wires.",
    btnExists: true,
    btnTitle: "Contact for Custom Alloys",
    btnURL: "/contact",
  },
  {
    isRightSection: true,
    title: "Equipment Sales & Support",
    subTitle:
      "We supply state-of-the-art thermal spray guns and systems. While we do not perform the coating ourselves, we ensure you have the best machinery to do the job. We also provide a comprehensive range of spare parts to keep your equipment operational.",
    single: false,
    imgOne: globalEquipmentSales,
    imgOneAlt: "Display of thermal spray guns and equipment.",
    imgTwo: spareParts,
    imgTwoAlt: "Spare parts inventory for spray guns.",
  },
  {
    isRightSection: false,
    title: "Technical Material Consultation",
    subTitle:
      "Our expertise lies in metallurgy. Our engineering team assists you in selecting the optimal wire or powder for your specific wear or corrosion challenge, ensuring you get the maximum performance from the materials we supply.",
    img: technicalConsultation,
    imgAlt: "Engineers discussing material specifications.",
  },
];

const pageTitle: string = `Supply Solutions | ${SITE.title}`;
const metaDescription =
  "MFOLKS Thermox is a dedicated manufacturer of thermal spray materials. We focus solely on supplying high-quality wires, powders, and equipment for your coating needs.";
const ogTitle = "Thermal Spray Supply Solutions | MFOLKS Thermox";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/services`,
    url: `${SITE.url}/services`,
    name: "Material Supply Solutions | MFOLKS Thermox",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    title="Dedicated to Material Excellence"
    subTitle="We specialize in the manufacturing and supply of premium thermal spray wires, powders, and equipment. We empower your operations with the best materials in the industry."
    btnExists={true}
    btnTitle="Request Material Quote"
    btnURL="/contact"
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt || "Service image"}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt || "Service image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt || "Service image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <FeaturesStats
    title="Proven Performance"
    subTitle="Our commitment to excellence is proven by the numbers. From small commercial jobs to massive industrial projects, MFOLKS Thermox services provide the reliability you can trust."
    mainStatTitle="500+"
    mainStatSubTitle="successful coating projects delivered"
    stats={[
      {
        stat: "100%",
        description: "compliance with ISO standards",
      },
      {
        stat: "25+",
        description: "years of technical expertise",
      },
      {
        stat: "0",
        description: "coating failures reported",
      },
    ]}
  />
</MainLayout>
