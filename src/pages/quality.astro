---
// Import necessary components
import MainLayout from "@layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import { SITE } from "@data/constants";
import { qualityContent } from "@data/new_content";

// Define placeholder image function
const getPlaceholder = (text: string) =>
  `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Quality Assurance | ${SITE.title}`;
const metaDescription = qualityContent.description;

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Quality as Culture",
    subTitle:
      "At MFOLKS, quality is a daily practice, not just a standard - we ensure every product meets customer and industry expectations. Our commitment to excellence ensures your infrastructure is protected by the best in the industry.",
    single: false,
    imgOne: getPlaceholder("Quality Control"),
    imgOneAlt: "Quality inspection in progress",
    imgTwo: getPlaceholder("Technical Specs"),
    imgTwoAlt: "Technical data sheets and specifications",
  },
  {
    isRightSection: false,
    title: "Empowered Workforce",
    subTitle:
      "Our team is well-trained, aware of quality responsibilities, and empowered to maintain high standards. We believe that skilled hands and sharp minds are the best tools for quality assurance.",
    img: getPlaceholder("Skilled Workforce"),
    imgAlt: "Team members collaborating on quality check",
    btnExists: true,
    btnTitle: "Enquire for Project Supply",
    btnURL: "/contact",
  },
  {
    isRightSection: true,
    title: "Continuous Improvement",
    subTitle:
      "We regularly review our quality objectives to drive process improvements and ensure long-term customer satisfaction. Feedback from production and field installations is used to refine processes and improve consistency.",
    single: true,
    imgOne: getPlaceholder("Process Improvement"),
    imgOneAlt: "Process optimization chart",
  },
];

const qualityFeatures = [
  {
    heading: "Raw Material Verification",
    content:
      "Rigorous testing of incoming aluminium, zinc, and alloy materials.",
    svg: "shield",
  },
  {
    heading: "Process Control",
    content:
      "Defined manufacturing procedures to ensure wire diameter and surface finish consistency.",
    svg: "settings",
  },
  {
    heading: "Inspection & Validation",
    content: "Visual and dimensional inspection of every spool and batch.",
    svg: "verified",
  },
  {
    heading: "Traceability",
    content: "Complete batch tracking from raw material to final dispatch.",
    svg: "books",
  },
];
---

<MainLayout title={pageTitle} customDescription={metaDescription}>
  <!-- Hero Section -->
  <MainSection
    title="Quality Without Compromise"
    subTitle={qualityContent.description}
    btnExists={true}
    btnTitle="Request Quality Documentation"
    btnURL="/contact"
  />

  <!-- Detailed Sections -->
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt || "Quality section image"}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt || "Quality section image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt || "Quality section image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <!-- Manufacturing Quality Controls -->
  <FeaturesGeneral
    title="Manufacturing Quality Controls"
    subTitle="Quality checks are integrated throughout production rather than treated as a final-stage activity."
    features={qualityFeatures}
  />

  <!-- Structured Quality Framework Text Section -->
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h3
          class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
        >
          Structured Quality Framework
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">
          Our quality framework emphasizes disciplined manufacturing practices.
          It focuses on process consistency, supplier evaluation, inspection
          checkpoints, and documentation control.
        </p>
      </div>
      <div>
        <h3
          class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
        >
          Industry Standards
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">
          We adhere to relevant IS and international standards for thermal spray
          wires and powders, ensuring global compatibility and performance.
        </p>
      </div>
    </div>
  </div>

  <!-- Technical Support CTA -->
  <div
    class="bg-neutral-50 dark:bg-neutral-900 border-y border-neutral-200 dark:border-neutral-700"
  >
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 text-center"
    >
      <h2
        class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
      >
        Technical Support & Enquiries
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 mb-8 max-w-2xl mx-auto">
        For inspection documentation, project requirements, or technical
        clarification, our engineering team is ready to assist.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="inline-flex justify-center items-center gap-x-3 text-center bg-blue-500 hover:bg-blue-600 border border-transparent text-white text-sm font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-white transition py-3 px-4 dark:focus:ring-offset-gray-800"
        >
          Contact Our Technical Team
        </a>
      </div>
    </div>
  </div>
</MainLayout>

