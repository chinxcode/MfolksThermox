---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

const getPlaceholder = (text: string) =>
    `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Dimensional Restoration | ${SITE.title}`;
const metaDescription =
    "Restore undersized or mis-machined shafts, rollers, and cylinders to their original dimensions with cold spray or arc spray coating.";

interface Article {
    isRightSection: boolean;
    title: string;
    subTitle: string;
    btnExists?: boolean;
    btnTitle?: string;
    btnURL?: string;
    single?: boolean;
    img?: any;
    imgAlt?: string;
    imgOne?: any;
    imgOneAlt?: string;
    imgTwo?: any;
    imgTwoAlt?: string;
}

const articles: Article[] = [
    {
        isRightSection: true,
        title: "Shaft Salvage & Repair",
        subTitle:
            "Worn bearing seats, seal areas, and journals on expensive shafts can be built up with stainless steel or nickel alloys, then ground to tolerance. This saves the cost and lead time of manufacturing new shafts.",
        single: false,
        imgOne: getPlaceholder("Shaft Repair"),
        imgOneAlt: "Technician applying metal build-up on a shaft",
        imgTwo: getPlaceholder("Finished Shaft"),
        imgTwoAlt: "Restored shaft ground to final dimensions",
    },
    {
        isRightSection: false,
        title: "Mis-Machined Parts Correction",
        subTitle:
            "Manufacturing errors happen. Instead of scrapping valuable components that were over-machined, thermal spray can add the missing material with excellent bond strength and no heat distortion.",
        img: getPlaceholder("Machined Part"),
        imgAlt: "Component undergoing dimensional correction",
        btnExists: true,
        btnTitle: "View Restoration Wires",
        btnURL: "/thermal-spray-wires",
    },
    {
        isRightSection: true,
        title: "Print Rollers & Cylinders",
        subTitle:
            "Paper and textile industry rollers wear down over time. We re-coat them with wear-resistant and corrosion-resistant alloys, often improving performance beyond OEM specifications.",
        single: true,
        imgOne: getPlaceholder("Roller Coating"),
        imgOneAlt: "Large industrial roller being coated",
    },
];
---

<MainLayout
    title={pageTitle}
    customDescription={metaDescription}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": `${SITE.url}/surface-restoration`,
        url: `${SITE.url}/surface-restoration`,
        name: "Dimensional Restoration | MFOLKS Thermox",
        description: metaDescription,
        isPartOf: {
            "@type": "WebSite",
            url: SITE.url,
            name: SITE.title,
        },
        inLanguage: "en-US",
    }}
>
    <MainSection
        title="Salvage Valuable Components"
        subTitle="Don't scrap it—spray it. Thermal spray build-up (metallizing) restores worn dimensions without the heat distortion risks of welding. Save time, money, and materials."
        btnExists={true}
        btnTitle="Send Repair Inquiry"
        btnURL="/contact"
    />

    {
        articles.map((article) => {
            return article.isRightSection ? (
                <RightSection
                    title={article.title}
                    subTitle={article.subTitle}
                    single={article.single}
                    imgOne={article.imgOne}
                    imgOneAlt={article.imgOneAlt || "Restoration image"}
                    imgTwo={article.imgTwo}
                    imgTwoAlt={article.imgTwoAlt || "Restoration image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            ) : (
                <LeftSection
                    title={article.title}
                    subTitle={article.subTitle}
                    img={article.img}
                    imgAlt={article.imgAlt || "Restoration image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            );
        })
    }

    <FeaturesStats
        title="Cold Process Advantage"
        subTitle="Unlike welding, thermal spray keeps the substrate temperature generally below 150°C, eliminating warping, stress, and metallurgical changes in the base metal."
        mainStatTitle="<150°C"
        mainStatSubTitle="Substrate Temperature"
        stats={[
            {
                stat: "No",
                description: "Heat Distortion",
            },
            {
                stat: "Any",
                description: "Thickness Build-up",
            },
            {
                stat: "Fast",
                description: "Turnaround Time",
            },
        ]}
    />
</MainLayout>
