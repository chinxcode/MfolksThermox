---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

const getPlaceholder = (text: string) =>
    `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Thermal Spray Powders | ${SITE.title}`;
const metaDescription =
    "Premium thermal spray powders tailored for wear resistance, thermal barriers, and corrosion protection. Including Tungsten Carbide, Chromium Carbide, and Ceramic Oxides.";

interface Article {
    isRightSection: boolean;
    title: string;
    subTitle: string;
    btnExists?: boolean;
    btnTitle?: string;
    btnURL?: string;
    single?: boolean;
    img?: any;
    imgAlt?: string;
    imgOne?: any;
    imgOneAlt?: string;
    imgTwo?: any;
    imgTwoAlt?: string;
}

const articles: Article[] = [
    {
        isRightSection: true,
        title: "Carbide Based Powders",
        subTitle:
            "For extreme wear and abrasion resistance. Our Tungsten Carbide (WC-Co, WC-Co-Cr) and Chromium Carbide (Cr3C2-NiCr) powders are ideal for oil & gas valves, pump screws, and heavy machinery.",
        single: false,
        imgOne: getPlaceholder("WC-Co Powder"),
        imgOneAlt: "Microscopic view of Tungsten Carbide powder",
        imgTwo: getPlaceholder("Valve Coating"),
        imgTwoAlt: "Coated valve component resisting abrasion",
    },
    {
        isRightSection: false,
        title: "Oxide & Ceramic Powders",
        subTitle:
            "Designed for thermal insulation, electrical resistivity, and corrosion protection at high temperatures. Applications include thermal barrier coatings (TBCs) for gas turbines and insulating layers for electronics.",
        img: getPlaceholder("Ceramic Powder Spray"),
        imgAlt: "Ceramic powder being sprayed on substrate",
        btnExists: true,
        btnTitle: "Explore Powders",
        btnURL: "/products",
    },
    {
        isRightSection: true,
        title: "Metal Alloy Powders",
        subTitle:
            "A wide range of self-fluxing alloys (NiCrBSi) and bond coat materials (NiAl) for restoration and intermediate layers. These ensure strong metallurgical bonds and excellent machinability.",
        single: true,
        imgOne: getPlaceholder("NiAl Bond Coat"),
        imgOneAlt: "Bond coat application process",
    },
];
---

<MainLayout
    title={pageTitle}
    customDescription={metaDescription}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": `${SITE.url}/thermal-spray-powders`,
        url: `${SITE.url}/thermal-spray-powders`,
        name: "Thermal Spray Powders | MFOLKS Thermox",
        description: metaDescription,
        isPartOf: {
            "@type": "WebSite",
            url: SITE.url,
            name: SITE.title,
        },
        inLanguage: "en-US",
    }}
>
    <MainSection
        title="Advanced Powder Solutions"
        subTitle="From wear-resistant carbides to thermal barrier ceramics, our powders are engineered for HVOF, Plasma, and Flame Spray systems."
        btnExists={true}
        btnTitle="Request Technical Data"
        btnURL="/contact"
    />

    {
        articles.map((article) => {
            return article.isRightSection ? (
                <RightSection
                    title={article.title}
                    subTitle={article.subTitle}
                    single={article.single}
                    imgOne={article.imgOne}
                    imgOneAlt={article.imgOneAlt || "Product image"}
                    imgTwo={article.imgTwo}
                    imgTwoAlt={article.imgTwoAlt || "Product image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            ) : (
                <LeftSection
                    title={article.title}
                    subTitle={article.subTitle}
                    img={article.img}
                    imgAlt={article.imgAlt || "Product image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            );
        })
    }

    <FeaturesStats
        title="Particle Precision"
        subTitle="Consistent particle size distribution and morphology are key to coating success. We ensure rigorous quality checks on every batch."
        mainStatTitle="100+"
        mainStatSubTitle="Powder grades available"
        stats={[
            {
                stat: "HVOF",
                description: "Optimized Grades",
            },
            {
                stat: "APS",
                description: "Plasma Spray Powders",
            },
            {
                stat: "<1%",
                description: "Porosity in premium coatings",
            },
        ]}
    />
</MainLayout>
