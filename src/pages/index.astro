---
// Import the necessary components
import MainLayout from "@layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import ClientsSection from "@components/sections/landing/ClientsSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import FeaturesStatsAlt from "@components/sections/features/FeaturesStatsAlt.astro";

// Import new content data
import {
  heroContent,
  aboutContent,
  productCategories,
  qualityContent,
} from "@data/new_content";

// Import placeholder image function is no longer needed for these sections but kept for others if used.
const getPlaceholder = (text: string) =>
  `https://placehold.co/1200x800?text=${encodeURIComponent(text)}`;

import heroImage from "@/assets/images/home/thermox_home_herosection.webp";
import wiresImage from "@/assets/images/home/Thermal Spray Wires.webp";
import powdersImage from "@/assets/images/home/Thermal Spray Powders.webp";
import equipmentImage from "@/assets/images/home/Equipment & Machinery.webp";
import sparesImage from "@/assets/images/home/Spare Parts & Consumables.webp";
import industriesServedImage from "@/assets/images/home/Industires Served.webp";
import qualityImage from "@/assets/images/home/Quality.webp";

const categoryImages = [wiresImage, powdersImage, equipmentImage, sparesImage];

const avatarSrcs: Array<string> = [
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&crop=faces",
  "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&h=300&fit=crop&crop=faces",
  "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop&crop=faces",
  "https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=300&h=300&fit=crop&crop=faces",
];
---

<MainLayout>
  <HeroSection
    title={heroContent.title}
    subTitle={heroContent.subTitle}
    primaryBtn={heroContent.primaryBtn}
    primaryBtnURL={heroContent.primaryBtnURL}
    secondaryBtn={heroContent.secondaryBtn}
    secondaryBtnURL={heroContent.secondaryBtnURL}
    withReview={true}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.9</span> / 5`
    starCount={5}
    reviews=`Trusted by Over <span class="font-bold">500+</span> Industry Leaders`
    src={heroImage}
    alt={heroContent.imagePrompt}
  />

  <FeaturesStats
    title={aboutContent.title}
    subTitle={aboutContent.description}
    mainStatTitle="1958"
    mainStatSubTitle="Roots tracing back to"
    stats={[
      {
        stat: "30,000",
        description: "MT/Annum Aluminium Capacity",
      },
      {
        stat: "12,000",
        description: "Sq. Mtrs. Manufacturing Area",
      },
      {
        stat: "6,000",
        description: "Km/Annum Power Cable Capacity",
      },
    ]}
  />

  <FeaturesNavs
    title=`Our <span class="text-blue-500 dark:text-blue-400">Product Categories</span>`
    tabs={productCategories.map((cat, index) => ({
      heading: cat.title,
      content: cat.description,
      svg:
        index === 0
          ? "tools"
          : index === 1
            ? "dashboard"
            : index === 2
              ? "rocket"
              : "puzzle",
      src: categoryImages[index],
      alt: cat.imagePrompt,
    }))}
  />

  <FeaturesGeneral
    title="Industries We Serve"
    subTitle="What truly sets us apart is how closely we stay connected to real world industry challenges. In sectors like power, marine, oil & gas, automotive and heavy engineering, we know that downtime is costly."
    src={industriesServedImage}
    alt="Industrial sectors including power, marine, oil & gas, automotive and heavy engineering"
    features={[
      {
        heading: "Power Sector",
        content:
          "Reliable thermal spray solutions for power generation equipment restoration.",
        svg: "hammer",
      },
      {
        heading: "Marine",
        content:
          "Corrosion protection for marine vessels and offshore structures.",
        svg: "shield",
      },
      {
        heading: "Oil & Gas",
        content:
          "Wear resistance coatings for valves, pumps, and drilling equipment.",
        svg: "tools",
      },
      {
        heading: "Automotive",
        content:
          "Surface strengthening for automotive components and engine parts.",
        svg: "rocket",
      },
      {
        heading: "Heavy Engineering",
        content:
          "Durable coatings for heavy machinery and structural components.",
        svg: "puzzle",
      },
    ]}
  />

  <FeaturesStatsAlt
    title={qualityContent.title}
    subTitle={qualityContent.description}
    benefits={[
      "Empowered Workforce - well-trained and quality-conscious",
      "Continuous Improvement - regular reviews and process refinements",
      "Customer Satisfaction - meeting industry expectations",
      "Precision & Consistency - crafted with focus on quality",
    ]}
    src={qualityImage}
    alt="Quality control laboratory with modern testing equipment and professional inspectors"
  />

  <TestimonialsSection
    title="Why Trust MFOLKS?"
    subTitle="We are more than just manufacturers. We are listeners, collaborators and problem solvers."
    testimonials={[
      {
        content:
          "MFOLKS thermal spray wires effectively extended the lifespan of our turbine components. Excellent quality and consistent performance.",
        author: "Industrial Manager",
        role: "Power Sector",
        avatarSrc:
          "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&crop=faces",
      },
    ]}
    statistics={[
      { count: "50+", description: "Years of Group Legacy" },
      { count: "30k", description: "MT Annual Capacity" },
      { count: "100%", description: "Commitment to Quality" },
      { count: "24/7", description: "Technical Support" },
    ]}
  />

  <HeroSectionAlt
    title="Let's Protect Your Equipment Together"
    subTitle="Contact our technical team for customized thermal spray solutions."
    url="/contact"
    btnTitle="Consult Our Team"
  />
</MainLayout>

