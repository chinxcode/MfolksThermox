---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

const getPlaceholder = (text: string) =>
    `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Thermal Spray Wires | ${SITE.title}`;
const metaDescription =
    "High-quality thermal spray wires including Aluminium, Zinc, Copper, Stainless Steel, and Nickel Alloys for corrosion protection and surface restoration.";

interface Article {
    isRightSection: boolean;
    title: string;
    subTitle: string;
    btnExists?: boolean;
    btnTitle?: string;
    btnURL?: string;
    single?: boolean;
    img?: any;
    imgAlt?: string;
    imgOne?: any;
    imgOneAlt?: string;
    imgTwo?: any;
    imgTwoAlt?: string;
}

const articles: Article[] = [
    {
        isRightSection: true,
        title: "Pure Metal Wires",
        subTitle:
            "We manufacture high-purity wires essential for corrosion protection and conductivity applications. Our range includes Aluminium (99.5%), Zinc (99.99%), Copper (99.9%), and various grades of Stainless Steel (316L, 420, 431).",
        single: false,
        imgOne: getPlaceholder("Aluminium Wire Spools"),
        imgOneAlt: "Industrial spools of aluminium thermal spray wire",
        imgTwo: getPlaceholder("Zinc Wire Production"),
        imgTwoAlt: "Zinc wire manufacturing process",
    },
    {
        isRightSection: false,
        title: "Metal Alloy Wires",
        subTitle:
            "Engineered for specific performance characteristics like high-temperature resistance, bond strength, and wear resistance. Our alloy portfolio includes NiAl 95/5, Inconel 625, Hastelloy C, and Aluminium Bronze.",
        img: getPlaceholder("Nickel Alloy Wire"),
        imgAlt: "Specialty alloy wire for thermal spray applications",
        btnExists: true,
        btnTitle: "View All Wires",
        btnURL: "/products",
    },
    {
        isRightSection: true,
        title: "Applications & Performance",
        subTitle:
            "From anti-corrosion coatings on large infrastructure (bridges, wind towers) to dimensional restoration of worn components (shafts, cylinders), our wires deliver consistent coating quality and high bond strength.",
        single: true,
        imgOne: getPlaceholder("Wire Spray Application"),
        imgOneAlt: "Thermal spray gun applying wire coating",
    },
];
---

<MainLayout
    title={pageTitle}
    customDescription={metaDescription}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": `${SITE.url}/thermal-spray-wires`,
        url: `${SITE.url}/thermal-spray-wires`,
        name: "Thermal Spray Wires | MFOLKS Thermox",
        description: metaDescription,
        isPartOf: {
            "@type": "WebSite",
            url: SITE.url,
            name: SITE.title,
        },
        inLanguage: "en-US",
    }}
>
    <MainSection
        title="Premium Thermal Spray Wires"
        subTitle="Engineered for consistency and performance. Our wires ensure smooth feeding and high-quality coatings for Arc and Flame spray systems."
        btnExists={true}
        btnTitle="Get a Quote"
        btnURL="/contact"
    />

    {
        articles.map((article) => {
            return article.isRightSection ? (
                <RightSection
                    title={article.title}
                    subTitle={article.subTitle}
                    single={article.single}
                    imgOne={article.imgOne}
                    imgOneAlt={article.imgOneAlt || "Product image"}
                    imgTwo={article.imgTwo}
                    imgTwoAlt={article.imgTwoAlt || "Product image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            ) : (
                <LeftSection
                    title={article.title}
                    subTitle={article.subTitle}
                    img={article.img}
                    imgAlt={article.imgAlt || "Product image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            );
        })
    }

    <FeaturesStats
        title="Manufacturing Excellence"
        subTitle="Our state-of-the-art wire drawing facility ensures strict adherence to dimensional tolerances and chemical composition."
        mainStatTitle="30,000"
        mainStatSubTitle="MT Annual Production Capacity"
        stats={[
            {
                stat: "99.99%",
                description: "Purity for Zinc wires",
            },
            {
                stat: "ISO",
                description: "Certified Manufacturing Processes",
            },
            {
                stat: "100%",
                description: "Spool traceability",
            },
        ]}
    />
</MainLayout>
