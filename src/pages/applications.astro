---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

import bridgeCorrosion from "@/assets/images/applications/bridge-corrosion.webp";
import hardFacing from "@/assets/images/applications/hard-facing-applications.webp";
import shaftRestoration from "@/assets/images/applications/shaft-restoration.webp";
import copperSpray from "@/assets/images/applications/copper-spray-coating.webp";
import thermalBarrier from "@/assets/images/applications/thermal-barrier-coating.webp";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Anti-Corrosion Solutions",
    subTitle:
      "Zinc and Aluminium thermal spray coatings provide long-term corrosion protection for bridges, wind towers, and offshore structures. Acting as a sacrificial anode, these coatings offer 25+ years of maintenance-free service life even in marine environments.",
    single: true,
    imgOne: bridgeCorrosion,
    imgOneAlt: "Thermal spray zinc coating on bridge infrastructure.",
  },
  {
    isRightSection: false,
    title: "Wear Resistance & Hard Facing",
    subTitle:
      "Tungsten Carbide and Chromium Carbide coatings protect critical components from abrasion, erosion, and fretting. Essential for oil & gas valves, pump shafts, and mining equipment, extending service life by up to 500%.",
    img: hardFacing,
    imgAlt: "HVOF coating application for wear resistance.",
    btnExists: true,
    btnTitle: "View Wear Resistant Powders",
    btnURL: "/thermal-spray-powders",
  },
  {
    isRightSection: true,
    title: "Dimensional Restoration",
    subTitle:
      "Restore undersized or mis-machined parts to their original dimensions. Shafts, rollers, and bearing seats can be built up with stainless steel or nickel alloys without heat distortion, saving the cost of manufacturing new components.",
    single: true,
    imgOne: shaftRestoration,
    imgOneAlt: "Dimensional restoration of a worn industrial shaft.",
  },
  {
    isRightSection: false,
    title: "Electrical Conductivity",
    subTitle:
      "Copper and Aluminium coatings provide excellent electrical conductivity on composite or ceramic substrates. Used in lightning protection, EMI shielding, and grounding connections for diverse industrial applications.",
    img: copperSpray,
    imgAlt: "Copper thermal spray for electrical conductivity.",
  },
  {
    isRightSection: true,
    title: "Thermal Barrier Coatings",
    subTitle:
      "Ceramic oxide coatings insulate components from extreme heat, improving efficiency in gas turbines and engine components. These coatings reduce thermal fatigue and allow higher operating temperatures.",
    single: true,
    imgOne: thermalBarrier,
    imgOneAlt: "Ceramic thermal barrier coating on turbine blade.",
    btnExists: true,
    btnTitle: "Consult on TBCs",
    btnURL: "/contact",
  },
];

const pageTitle: string = `Applications | ${SITE.title}`;
const metaDescription =
  "MFOLKS Thermox delivers specialized thermal spray solutions for Anti-Corrosion, Wear Resistance, and Surface Restoration across Oil & Gas, Power, and Infrastructure sectors.";
const ogTitle = "Industry Applications | MFOLKS Thermox";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/applications`,
    url: `${SITE.url}/applications`,
    name: "Thermal Spray Applications by Industry | MFOLKS Thermox",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    title="Surface Engineering for Critical Industries"
    subTitle="From offshore platforms battling corrosion to mining equipment facing extreme abrasion, MFOLKS Thermox provides tailored surface solutions. We extend component life and improve performance where it matters most."
    btnExists={true}
    btnTitle="Discuss Your Application"
    btnURL="/contact"
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt || "Article image"}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt || "Article image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt || "Article image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <FeaturesStats
    title="Proven across Sectors"
    subTitle="Trusted by leading OEMs and maintenance teams for reliability and coating excellence."
    mainStatTitle="100+"
    mainStatSubTitle="Unique applications engineered"
    stats={[
      {
        stat: "ISO",
        description: "Standard compliant coatings",
      },
      {
        stat: "HVOF",
        description: "High Velocity Technology",
      },
      {
        stat: "30+",
        description: "Years of expertise",
      },
    ]}
  />
</MainLayout>
