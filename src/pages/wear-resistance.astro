---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

const getPlaceholder = (text: string) =>
    `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Wear Resistance & Surface Hardening | ${SITE.title}`;
const metaDescription =
    "Combat erosion, abrasion, and cavitation. Tungsten Carbide and self-fluxing alloy coatings extend the life of industrial components.";

interface Article {
    isRightSection: boolean;
    title: string;
    subTitle: string;
    btnExists?: boolean;
    btnTitle?: string;
    btnURL?: string;
    single?: boolean;
    img?: any;
    imgAlt?: string;
    imgOne?: any;
    imgOneAlt?: string;
    imgTwo?: any;
    imgTwoAlt?: string;
}

const articles: Article[] = [
    {
        isRightSection: true,
        title: "Heavy Machinery & Earthmoving",
        subTitle:
            "Buckets, teeth, pins, and mining equipment suffer extreme abrasion. HVOF coatings with Tungsten Carbide increase surface hardness (up to 70 HRc) and multiply component life.",
        single: false,
        imgOne: getPlaceholder("Mining Bucket"),
        imgOneAlt: "Mining bucket being coated for wear protection",
        imgTwo: getPlaceholder("Excavator"),
        imgTwoAlt: "Heavy excavator working in harsh conditions",
    },
    {
        isRightSection: false,
        title: "Oil & Gas Components",
        subTitle:
            "Valves, pump plungers, and drilling tools face aggressive slurry erosion. Our carbide powders provide a dense, hard-facing layer that maintains dimensional tolerance under pressure.",
        img: getPlaceholder("Oil Gas Valve"),
        imgAlt: "Coated valve gate for oil and gas industry",
        btnExists: true,
        btnTitle: "View Hard-Facing Powders",
        btnURL: "/thermal-spray-powders",
    },
    {
        isRightSection: true,
        title: "Power Generation",
        subTitle:
            "Hydro turbine runners suffer from cavitation; coal-fired boiler tubes face erosion. Specialized alloy coatings protect these surfaces, ensuring efficiency and reducing forced outages.",
        single: true,
        imgOne: getPlaceholder("Hydro Turbine"),
        imgOneAlt: "Hydro turbine runner cavitation repair",
    },
];
---

<MainLayout
    title={pageTitle}
    customDescription={metaDescription}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": `${SITE.url}/wear-resistance`,
        url: `${SITE.url}/wear-resistance`,
        name: "Wear Resistance | MFOLKS Thermox",
        description: metaDescription,
        isPartOf: {
            "@type": "WebSite",
            url: SITE.url,
            name: SITE.title,
        },
        inLanguage: "en-US",
    }}
>
    <MainSection
        title="Extend Component Life"
        subTitle="Don't replace—reinforce. Our high-velocity thermal spray coatings (HVOF) create surfaces harder than the original substrate, tackling sliding wear, erosion, and fretting."
        btnExists={true}
        btnTitle="Discuss Wear Problems"
        btnURL="/contact"
    />

    {
        articles.map((article) => {
            return article.isRightSection ? (
                <RightSection
                    title={article.title}
                    subTitle={article.subTitle}
                    single={article.single}
                    imgOne={article.imgOne}
                    imgOneAlt={article.imgOneAlt || "Application image"}
                    imgTwo={article.imgTwo}
                    imgTwoAlt={article.imgTwoAlt || "Application image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            ) : (
                <LeftSection
                    title={article.title}
                    subTitle={article.subTitle}
                    img={article.img}
                    imgAlt={article.imgAlt || "Application image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            );
        })
    }

    <FeaturesStats
        title="Reduce Downtime"
        subTitle="Hard-facing critical components means fewer change-outs, less maintenance downtime, and higher operational availability."
        mainStatTitle="5x"
        mainStatSubTitle="Life Extension (vs uncoated steel)"
        stats={[
            {
                stat: "70 HRC",
                description: "Hardness achievable",
            },
            {
                stat: "Dense",
                description: "<1% Porosity (HVOF)",
            },
            {
                stat: "Bond",
                description: ">10,000 PSI Bond Strength",
            },
        ]}
    />
</MainLayout>
