---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

const getPlaceholder = (text: string) =>
    `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Anti-Corrosion Coatings | ${SITE.title}`;
const metaDescription =
    "Long-term corrosion protection using Zinc, Aluminium, and ZnAl alloy thermal spray coatings. Ideal for bridges, offshore structures, and infrastructure.";

interface Article {
    isRightSection: boolean;
    title: string;
    subTitle: string;
    btnExists?: boolean;
    btnTitle?: string;
    btnURL?: string;
    single?: boolean;
    img?: any;
    imgAlt?: string;
    imgOne?: any;
    imgOneAlt?: string;
    imgTwo?: any;
    imgTwoAlt?: string;
}

const articles: Article[] = [
    {
        isRightSection: true,
        title: "TSA - Thermal Spray Aluminium",
        subTitle:
            "Proven protection for offshore oil & gas platforms, risers, and splash zones. TSA provides barrier and cathodic protection, lasting 30+ years in marine environments with minimal maintenance.",
        single: false,
        imgOne: getPlaceholder("Offshore Platform"),
        imgOneAlt: "Offshore platform protected with TSA",
        imgTwo: getPlaceholder("TSA Application"),
        imgTwoAlt: "Diver applying TSA coating underwater or on splash zone",
    },
    {
        isRightSection: false,
        title: "Zinc & ZnAl Coatings",
        subTitle:
            "Ideal for atmospheric corrosion protection on bridges, wind towers, and general infrastructure. Zinc acts as a sacrificial anode, protecting the steel substrate even if the coating is scratched.",
        img: getPlaceholder("Bridge Coating"),
        imgAlt: "Large bridge structure being metalized with Zinc",
        btnExists: true,
        btnTitle: "View Zinc Wires",
        btnURL: "/thermal-spray-wires",
    },
    {
        isRightSection: true,
        title: "Infrastructure & Public Works",
        subTitle:
            "Municipalities and highway authorities specify thermal spray for light poles, railings, and sluice gates to reduce lifecycle maintenance costs compared to paint systems.",
        single: true,
        imgOne: getPlaceholder("Infrastructure Project"),
        imgOneAlt: "Municipal infrastructure protected against corrosion",
    },
];
---

<MainLayout
    title={pageTitle}
    customDescription={metaDescription}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": `${SITE.url}/anti-corrosion-coatings`,
        url: `${SITE.url}/anti-corrosion-coatings`,
        name: "Anti-Corrosion Coatings | MFOLKS Thermox",
        description: metaDescription,
        isPartOf: {
            "@type": "WebSite",
            url: SITE.url,
            name: SITE.title,
        },
        inLanguage: "en-US",
    }}
>
    <MainSection
        title="Superior Corrosion Protection"
        subTitle="Why paint again and again? Thermal spray metallization (TSA/TSZ) offers decades of maintenance-free protection for critical steel assets in the harshest environments."
        btnExists={true}
        btnTitle="Consult Our Experts"
        btnURL="/contact"
    />

    {
        articles.map((article) => {
            return article.isRightSection ? (
                <RightSection
                    title={article.title}
                    subTitle={article.subTitle}
                    single={article.single}
                    imgOne={article.imgOne}
                    imgOneAlt={article.imgOneAlt || "Application image"}
                    imgTwo={article.imgTwo}
                    imgTwoAlt={article.imgTwoAlt || "Application image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            ) : (
                <LeftSection
                    title={article.title}
                    subTitle={article.subTitle}
                    img={article.img}
                    imgAlt={article.imgAlt || "Application image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            );
        })
    }

    <FeaturesStats
        title="Lifecycle Value"
        subTitle="While initial application cost may be higher than paint, the 25-50 year service life of thermal spray makes it the most economical choice for long-term asset protection."
        mainStatTitle="50+"
        mainStatSubTitle="Years Service Life (TSA)"
        stats={[
            {
                stat: "Zero",
                description: "Hidden corrosion creep",
            },
            {
                stat: "100%",
                description: "Bond strength to substrate",
            },
            {
                stat: "Low",
                description: "Lifecycle maintenance cost",
            },
        ]}
    />
</MainLayout>
