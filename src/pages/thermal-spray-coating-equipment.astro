---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { SITE } from "@data/constants";

const getPlaceholder = (text: string) =>
    `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `Thermal Spray Equipment | ${SITE.title}`;
const metaDescription =
    "Complete range of thermal spray equipment: Arc Spray Guns, Flame Spray Guns, Blasting Hoppers, and Booths.";

interface Article {
    isRightSection: boolean;
    title: string;
    subTitle: string;
    btnExists?: boolean;
    btnTitle?: string;
    btnURL?: string;
    single?: boolean;
    img?: any;
    imgAlt?: string;
    imgOne?: any;
    imgOneAlt?: string;
    imgTwo?: any;
    imgTwoAlt?: string;
}

const articles: Article[] = [
    {
        isRightSection: true,
        title: "Arc Spray Systems",
        subTitle:
            "High-deposition electric arc spray systems for zinc, aluminium, and alloy coatings. Our arc guns are robust, lightweight, and designed for continuous industrial use with minimal maintenance.",
        single: false,
        imgOne: getPlaceholder("Arc Spray Gun"),
        imgOneAlt: "Arc spray gun and power source",
        imgTwo: getPlaceholder("Site Coating Application"),
        imgTwoAlt: "Operator using arc spray system on site",
    },
    {
        isRightSection: false,
        title: "Flame Spray Guns",
        subTitle:
            "Versatile powder and wire flame spray guns. Ideal for metallic, ceramic, and carbide coatings. Our guns offer precise gas flow control for consistent flame temperature and particle velocity.",
        img: getPlaceholder("Powder Flame Gun"),
        imgAlt: "Operator using powder flame spray gun",
        btnExists: true,
        btnTitle: "View Spray Guns",
        btnURL: "/products",
    },
    {
        isRightSection: true,
        title: "Blasting & Surface Prep",
        subTitle:
            "Surface preparation is 80% of coating success. We supply sand blasting hoppers, nozzles, and complete blast room setups to ensure the perfect anchor profile for thermal spray coatings.",
        single: true,
        imgOne: getPlaceholder("Sand Blasting Hopper"),
        imgOneAlt: "Industrial sand blasting hopper unit",
    },
];
---

<MainLayout
    title={pageTitle}
    customDescription={metaDescription}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": `${SITE.url}/thermal-spray-coating-equipment`,
        url: `${SITE.url}/thermal-spray-coating-equipment`,
        name: "Thermal Spray Equipment | MFOLKS Thermox",
        description: metaDescription,
        isPartOf: {
            "@type": "WebSite",
            url: SITE.url,
            name: SITE.title,
        },
        inLanguage: "en-US",
    }}
>
    <MainSection
        title="Reliable Spray Systems"
        subTitle="From field-ready portable units to fully automated booth setups, MFOLKS Thermox provides the hardware you need to get the job done right."
        btnExists={true}
        btnTitle="Discuss Equipment Needs"
        btnURL="/contact"
    />

    {
        articles.map((article) => {
            return article.isRightSection ? (
                <RightSection
                    title={article.title}
                    subTitle={article.subTitle}
                    single={article.single}
                    imgOne={article.imgOne}
                    imgOneAlt={article.imgOneAlt || "Product image"}
                    imgTwo={article.imgTwo}
                    imgTwoAlt={article.imgTwoAlt || "Product image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            ) : (
                <LeftSection
                    title={article.title}
                    subTitle={article.subTitle}
                    img={article.img}
                    imgAlt={article.imgAlt || "Product image"}
                    btnExists={article.btnExists}
                    btnTitle={article.btnTitle}
                    btnURL={article.btnURL}
                />
            );
        })
    }

    <FeaturesStats
        title="Built for Industry"
        subTitle="Rough handling, dust, and continuous operation—our equipment is designed to withstand the realities of thermal spray workshops and job sites."
        mainStatTitle="24/7"
        mainStatSubTitle="Technical Support & Spares Availability"
        stats={[
            {
                stat: "Portable",
                description: "Field-ready units",
            },
            {
                stat: "Automated",
                description: "PLC controlled options",
            },
            {
                stat: "Complete",
                description: "Turnkey booth solutions",
            },
        ]}
    />
</MainLayout>
