---
// Import necessary components
import MainLayout from "@layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import { SITE } from "@data/constants";
import { aboutContent } from "@data/new_content";

// Define placeholder image function
const getPlaceholder = (text: string) =>
  `https://placehold.co/1000x600?text=${encodeURIComponent(text)}`;

const pageTitle = `About Us | ${SITE.title}`;
const metaDescription = aboutContent.description;

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "1958 Legacy & Expertise",
    subTitle:
      "With roots tracing back to 1958, MFOLKS comes from one of India's oldest business groups in the aluminium and copper ecosystem. Over the decades, we've built deep expertise and are channeling that experience into thermal spray technology.",
    single: true,
    imgOne: getPlaceholder("1958 Legacy"),
    imgOneAlt: "Vintage industrial photo representing 1958 legacy",
  },
  {
    isRightSection: false,
    title: "Manufacturing Excellence in Rajasthan & Gujarat",
    subTitle:
      "Our Manufacturing Units are located in the industrial townships of Bhiwadi and Chopanki (Rajasthan) and Narol, Ahmedabad (Gujarat). Spread over 12,000 sq. mtrs., we have an installed capacity of 30,000 M.Ts. of Aluminium Products and 6,000 Km of LT Power Cable per annum.",
    img: getPlaceholder("Manufacturing Facility"),
    imgAlt: "Aerial view of manufacturing units in Bhiwadi and Ahmedabad",
  },
  {
    isRightSection: true,
    title: "Mission: Durability & Performance",
    subTitle:
      "Our goal is simple: to create spray wires that last longer, perform better, and keep your equipment running reliably. Whether it's corrosion protection, part restoration or surface strengthening, our solutions are made to deliver and made to last.",
    single: true,
    imgOne: getPlaceholder("Durability Testing"),
    imgOneAlt: "Laboratory testing of thermal spray wire durability",
  },
  {
    isRightSection: false,
    title: "Customer-Centric Approach",
    subTitle:
      "At MFOLKS, we're more than just manufacturers. We're listeners, collaborators, and problem solvers. As the demand for advanced surface technologies grows, we're here to support you with dependable products and technical clarity.",
    img: getPlaceholder("Customer Collaboration"),
    imgAlt: "Engineers collaborating with clients on site",
  },
];

const supportFeatures = [
  {
    heading: "Power Sector",
    content: "Boilers, turbines, and structural protection.",
    svg: "building",
  },
  {
    heading: "Infrastructure",
    content: "Bridges, railways, and public works corrosion control.",
    svg: "hammer",
  },
  {
    heading: "Oil & Gas",
    content: "Refineries, pipelines, and offshore assets.",
    svg: "sparks",
  },
  {
    heading: "Automotive",
    content: "Engine components, piston rings, and shifters.",
    svg: "shield",
  },
];
---

<MainLayout title={pageTitle} customDescription={metaDescription}>
  <!-- Hero Section -->
  <MainSection
    title="About MFOLKS Industries"
    subTitle={aboutContent.description}
  />

  <!-- Detailed Sections -->
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt || "About section image"}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt || "About section image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt || "About section image"}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <!-- Engineering & Improvement Text Grid -->
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h3
          class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
        >
          Engineering-Focused Approach
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">
          Every wire is crafted with a focus on precision, quality, and
          consistency. We know that downtime is costly in effective industries,
          so our wires are engineered for trust—smoother coatings, better
          adhesion, and reduced maintenance.
        </p>
      </div>
      <div>
        <h3
          class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
        >
          Commitment to Success
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">
          As the demand for advanced surface technologies grows, we are here to
          support you with dependable products, technical clarity, and a
          commitment to helping you succeed.
        </p>
      </div>
    </div>
  </div>

  <!-- Supporting Projects Features -->
  <FeaturesGeneral
    title="Supporting Key Industries"
    subTitle="MFOLKS products are intended for demanding applications in Power, Marine, Oil & Gas, Automotive, and Heavy Engineering."
    features={supportFeatures}
  />

  <!-- Technical Enquiries CTA -->
  <div
    class="bg-neutral-50 dark:bg-neutral-900 border-y border-neutral-200 dark:border-neutral-700"
  >
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 text-center"
    >
      <h2
        class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
      >
        Technical Enquiries & Project Support
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 mb-8 max-w-2xl mx-auto">
        For project-specific requirements, documentation requests, or technical
        clarification.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="inline-flex justify-center items-center gap-x-3 text-center bg-blue-500 hover:bg-blue-600 border border-transparent text-white text-sm font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-white transition py-3 px-4 dark:focus:ring-offset-gray-800"
        >
          Contact Our Technical Team
        </a>
      </div>
    </div>
  </div>
</MainLayout>

